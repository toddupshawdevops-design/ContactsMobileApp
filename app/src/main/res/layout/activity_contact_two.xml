<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#F4F7FB">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/contact_details" android:textSize="28sp" android:textStyle="bold"
        android:textColor="#17324D" android:layout_marginBottom="24dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/aaron_adams" android:textSize="23sp" android:textStyle="bold"
        android:textColor="#172B3A" android:layout_marginBottom="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/aaron_phone" android:textSize="18sp" android:padding="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/aaron_email" android:textSize="18sp" android:padding="8dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/aaron_address" android:textSize="18sp" android:padding="8dp"/>
    <Button android:id="@+id/btnBackTwo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/back_to_contacts" android:layout_marginTop="24dp"/>
</LinearLayout>
